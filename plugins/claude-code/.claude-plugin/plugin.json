{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "raia",
  "displayName": "raia Agent DevKit",
  "version": "0.1.0",
  "description": "Build, validate, evaluate, release, and deploy raia agents safely from Claude Code.",
  "author": {
    "name": "raia"
  },
  "homepage": "https://docs.raiaai.com/",
  "repository": "https://github.com/raia-ai/raia-agent-devkit",
  "license": "UNLICENSED",
  "keywords": ["raia", "ai-agents", "evaluations", "lifecycle", "deployment"],
  "defaultEnabled": false,
  "skills": "./skills/",
  "agents": [
    "./agents/prompt-reviewer.md",
    "./agents/function-integration-reviewer.md",
    "./agents/knowledge-retrieval-reviewer.md",
    "./agents/evaluation-designer.md",
    "./agents/release-reviewer.md"
  ],
  "hooks": "./hooks/hooks.json",
  "mcpServers": "./.mcp.json"
}
