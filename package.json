{
  "name": "raia-agent-devkit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build && node scripts/build-plugin.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "node packages/contracts/scripts/generate-types.mjs",
    "generate:check": "node packages/contracts/scripts/generate-types.mjs --check",
    "contracts:check": "node packages/contracts/scripts/check-sync.mjs",
    "preflight": "node docs/raia-devkit-spec/preflight.mjs",
    "changeset": "changeset",
    "build:plugin": "node scripts/build-plugin.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@eslint/js": "^9.28.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.28.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.4"
  }
}
