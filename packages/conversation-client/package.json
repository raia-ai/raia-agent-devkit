{
  "name": "@raia/conversation-client",
  "version": "0.1.0",
  "description": "Contract-selected raia conversation runtime client generated from the pinned external-openapi-v1 vendor contract.",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "generate": "node scripts/generate-contract.mjs",
    "check-sync": "node scripts/check-contract-sync.mjs"
  },
  "dependencies": {
    "@raia/contracts": "workspace:*",
    "@raia/eval-engine": "workspace:*",
    "@raia/provider-http": "workspace:*"
  },
  "devDependencies": {
    "@raia/core": "workspace:*"
  }
}
