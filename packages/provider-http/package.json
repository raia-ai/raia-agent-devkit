{
  "name": "@raia/provider-http",
  "version": "0.1.0",
  "description": "HTTP ManagementProvider for the proposed raia agent-devkit management contract, with typed errors and bounded retries.",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@raia/contracts": "workspace:*"
  },
  "devDependencies": {
    "@raia/core": "workspace:*",
    "@raia/mock-management-api": "workspace:*",
    "@raia/provider-mock": "workspace:*"
  }
}
